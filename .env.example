# Absolute path to the Emulation directory on the Docker host.
EMULATION_ROOT=/srv/Emulation

# Host directory backing RetroArch's WebDAV cloud storage.
RETROARCH_CLOUD_ROOT=/path/to/webdav/RetroArch

# Owns the SQLite database and deduplicated save snapshot blobs.
ROMMATES_DATA_ROOT=./data

# Required. Generate with: openssl rand -hex 32
# Startup fails if this is missing or shorter than 16 characters.
ROMMATES_ACCESS_TOKEN=replace-with-a-long-random-token

# Linux account that owns the Emulation and WebDAV directories.
PUID=1000
PGID=1000

# Set ROMMATES_BIND=127.0.0.1 when using an authenticated reverse proxy.
ROMMATES_BIND=0.0.0.0
ROMMATES_PORT=8080

# Largest share of the catalog one scan may delete on its own (0.0-1.0).
# Protects device selections when the library volume is missing or half-mounted.
# ROMMATES_SCAN_PRUNE_LIMIT=0.5

# Platforms where each immediate child folder is one complete game bundle.
ROMMATES_FOLDER_BUNDLE_PLATFORMS=ps3

# Optional browser transfer limits. Defaults are 128 GiB per upload and 8 MiB chunks.
# ROMMATES_UPLOAD_MAX_BYTES=137438953472
# ROMMATES_UPLOAD_CHUNK_BYTES=8388608
# ROMMATES_UPLOAD_EXPIRY_HOURS=24
# ROMMATES_DOWNLOAD_TICKET_SECONDS=300

# Only set this if an authenticated reverse proxy already protects the app.
# It disables ROMmates' own token check entirely.
# ROMMATES_ALLOW_ANONYMOUS=false

# These seed a new database. The same values can then be managed in the Saves UI.
ROMMATES_SAVE_SNAPSHOT_INTERVAL_MINUTES=360
ROMMATES_SAVE_RETENTION_RECENT=24
ROMMATES_SAVE_RETENTION_DAILY=30
ROMMATES_SAVE_RETENTION_WEEKLY=12
ROMMATES_SAVE_RETENTION_MONTHLY=12
