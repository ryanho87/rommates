# Absolute path to the Emulation directory on the Docker host.
EMULATION_ROOT=/srv/Emulation

# Owns the SQLite database and deduplicated save snapshot blobs.
ROMMATES_DATA_ROOT=./data

# Required. Generate with: openssl rand -hex 32
# Startup fails if this is missing or shorter than 16 characters.
ROMMATES_ACCESS_TOKEN=replace-with-a-long-random-token

# Linux account that owns the Emulation directory.
PUID=1000
PGID=1000

# Set ROMMATES_BIND=127.0.0.1 when using an authenticated reverse proxy.
ROMMATES_BIND=0.0.0.0
ROMMATES_PORT=8080

# Optional Syncthing status, share provisioning, and rescan integration. The URL must be
# reachable from the ROMmates container. Generate/copy the API key from
# Syncthing: Actions > Settings > General > API Key.
# ROMMATES_SYNCTHING_URL=http://syncthing:8384
# ROMMATES_SYNCTHING_API_KEY=replace-with-your-syncthing-api-key
# Set this when Syncthing sees device folders at a different container path.
# ROMMATES_SYNCTHING_DEVICES_ROOT=/media/Emulation/devices
# ROMMATES_SYNCTHING_TIMEOUT_SECONDS=2
# ROMMATES_SYNCTHING_CACHE_SECONDS=10

# Optional outbound Discord notifications. Create a webhook in the target Discord
# channel and keep its URL secret. The public URL adds links back to ROMmates.
# ROMMATES_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ROMMATES_DISCORD_TIMEOUT_SECONDS=5
# ROMMATES_PUBLIC_URL=https://rommates.example.com

# Optional dedicated hostname for the native app. Requests received on this host
# are limited to the mobile route allowlist and require a mobile bearer session.
# Keep the full web/admin hostname behind Cloudflare Access.
# ROMMATES_MOBILE_PUBLIC_HOSTS=api.rommates.example.com

# Optional native iOS push notifications. ROMmates reuses Boba Tracker's APNs provider
# key on the same Apple Developer team, but sends with its own bundle ID/topic. Keep the
# private key on the server; never commit it. TestFlight uses production APNs.
# ROMMATES_APNS_KEY_PATH=/data/secrets/AuthKey_64VLU2D5LV.p8
# ROMMATES_APNS_KEY_ID=64VLU2D5LV
# ROMMATES_APNS_TEAM_ID=2NKFMTXAX5
# ROMMATES_APNS_BUNDLE_ID=com.rommates.app
# ROMMATES_APNS_ENVIRONMENT=production
# ROMMATES_APNS_TIMEOUT_SECONDS=10

# Largest share of the catalog one scan may delete on its own (0.0-1.0).
# Protects device selections when the library volume is missing or half-mounted.
# ROMMATES_SCAN_PRUNE_LIMIT=0.5

# Platforms where each immediate child folder is one complete game bundle.
ROMMATES_FOLDER_BUNDLE_PLATFORMS=ps3,wiiu

# New or changed files larger than 512 MiB are indexed from filesystem metadata.
# Their content hash is deferred so large optical-disc images do not block scans.
# Set to 0 to restore full SHA-256 hashing for files of every size.
ROMMATES_HASH_MAX_BYTES=536870912

# Optional browser transfer limits. Defaults are 128 GiB per upload and 8 MiB chunks.
# ROMMATES_UPLOAD_MAX_BYTES=137438953472
# ROMMATES_UPLOAD_CHUNK_BYTES=8388608
# ROMMATES_UPLOAD_EXPIRY_HOURS=24
# ROMMATES_DOWNLOAD_TICKET_SECONDS=300

# Only set this if an authenticated reverse proxy already protects the app.
# It disables ROMmates' own token check entirely.
# ROMMATES_ALLOW_ANONYMOUS=false

# These seed a new database. The same values can then be managed in the Saves UI.
ROMMATES_SAVE_SNAPSHOT_INTERVAL_MINUTES=360
ROMMATES_SAVE_RETENTION_RECENT=24
ROMMATES_SAVE_RETENTION_DAILY=30
ROMMATES_SAVE_RETENTION_WEEKLY=12
ROMMATES_SAVE_RETENTION_MONTHLY=12
