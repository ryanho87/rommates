# Absolute path to the Emulation directory on the Docker host.
EMULATION_ROOT=/srv/Emulation

# Generate with: openssl rand -hex 32
ROM_ACCESS_TOKEN=replace-with-a-long-random-token

# Linux account that owns the Emulation directory.
PUID=1000
PGID=1000

# Set ROM_MANAGER_BIND=127.0.0.1 when using an authenticated reverse proxy.
ROM_MANAGER_BIND=0.0.0.0
ROM_MANAGER_PORT=8080
